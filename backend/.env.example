# Copy to .env and fill in. (.env is gitignored.)

# MongoDB — local or Atlas. For Atlas, whitelist your IP in Network Access.
MONGO_URI=mongodb://localhost:27017/campusease

# API server port
PORT=3200

# JWT signing secret
SECRET_KEY=change_me_to_a_long_random_string

# Email (optional) — Gmail app password. Needed for OTP-attendance / reset emails.
# When unset, OTP-attendance runs in dev mode and returns the OTP in the API response.
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_gmail_app_password

# Khalti ePayment (KPG-2)
# Sandbox: https://dev.khalti.com/api/v2  — keys from https://test-admin.khalti.com/#/settings/keys
# Production: https://khalti.com/api/v2  — keys from https://admin.khalti.com
# Header is sent as: Authorization: Key <KHALTI_SECRET_KEY>  (use the key string exactly as shown)
# Sandbox test login → Khalti ID 9800000000, MPIN 1111, OTP 987654
KHALTI_BASE_URL=https://dev.khalti.com/api/v2
KHALTI_SECRET_KEY=your_khalti_secret_key_here
KHALTI_PUBLIC_KEY=your_khalti_public_key_here
FRONTEND_URL=http://localhost:4200
